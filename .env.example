# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password
# Set to 0 only if the admin login cookie does not work on http://localhost
COOKIE_SECURE=1
# Set to 1 when running behind a proxy such as Render or PythonAnywhere
TRUST_PROXY=0
